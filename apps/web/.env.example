# Backend URL used by the Next.js server to proxy /api/* requests (server-side, not exposed to browser)
API_INTERNAL_URL=http://localhost:4000
# Optional: public API URL if you prefer the browser to call the API directly (CORS must allow it)
# NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_APP_NAME=TutorSurvey
