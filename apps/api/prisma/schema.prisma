// ─────────────────────────────────────────────────────────────────────────────
//  TutorSurvey Bot — Database schema (PostgreSQL + Prisma 7)
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────────────────

enum RoleKey {
  SUPER_ADMIN
  DIRECTOR
  CEO
  HR_ADMIN
  TUTOR
  TEACHER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  PENDING // registered via Telegram, awaiting approval
}

enum Language {
  UZ
  RU
  EN
}

enum SurveyStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum SurveyAudience {
  ALL
  TUTORS
  TEACHERS
  BRANCH
  SELECTED
}

enum QuestionType {
  TEXT
  LONG_TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  RATING
  YES_NO
  NUMBER
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum ReportType {
  DAILY
  WEEKLY
  MONTHLY
  PROBLEM
  STUDENT_FEEDBACK
  LESSON
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVISION
}

enum NotificationType {
  SURVEY_ASSIGNED
  SURVEY_DEADLINE
  SURVEY_COMPLETED
  ANNOUNCEMENT
  TASK
  REPORT_DEADLINE
  REPORT_REVIEWED
  ADMIN_MESSAGE
  SYSTEM
}

enum NotificationChannel {
  TELEGRAM
  WEB
  BOTH
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  READ
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum KpiMetricKey {
  ATTENDANCE
  REPORTS_SUBMITTED
  SURVEY_COMPLETION
  STUDENT_FEEDBACK
  TASK_COMPLETION
  TUTOR_ACTIVITY
  TEACHER_ACTIVITY
}

enum KpiPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
}

// ───────────────────────────── RBAC ──────────────────────────────────────────

model Role {
  id          String           @id @default(cuid())
  key         RoleKey          @unique
  name        String // Uzbek label, e.g. "Direktor"
  description String?
  isSystem    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // e.g. "surveys.create"
  group       String // e.g. "surveys"
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ───────────────────────────── Organisation ──────────────────────────────────

model Branch {
  id           String       @id @default(cuid())
  name         String
  code         String       @unique // e.g. "CHL"
  address      String?
  phone        String?
  city         String?
  studentCount Int          @default(0)
  isActive     Boolean      @default(true)
  directorId   String?      @unique
  ceoId        String?
  director     User?        @relation("BranchDirector", fields: [directorId], references: [id], onDelete: SetNull)
  ceo          User?        @relation("BranchCeo", fields: [ceoId], references: [id], onDelete: SetNull)
  users        User[]       @relation("BranchMembers")
  departments  Department[]
  groups       Group[]
  surveys      Survey[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("branches")
}

model Department {
  id        String   @id @default(cuid())
  name      String
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  users     User[]
  createdAt DateTime @default(now())

  @@unique([name, branchId])
  @@map("departments")
}

model Group {
  id           String   @id @default(cuid())
  name         String // e.g. "IELTS-12"
  subject      String?
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tutorId      String?
  tutor        User?    @relation("GroupTutor", fields: [tutorId], references: [id], onDelete: SetNull)
  teacherId    String?
  teacher      User?    @relation("GroupTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  studentCount Int      @default(0)
  isActive     Boolean  @default(true)
  reports      Report[]
  createdAt    DateTime @default(now())

  @@map("groups")
}

// ───────────────────────────── Users ─────────────────────────────────────────

model User {
  id               String     @id @default(cuid())
  fullName         String
  email            String?    @unique
  phone            String?    @unique
  passwordHash     String? // null for Telegram-only users
  telegramId       BigInt?    @unique
  telegramUsername String?
  telegramChatId   BigInt?
  avatarUrl        String?
  language         Language   @default(UZ)
  roleId           String
  role             Role       @relation(fields: [roleId], references: [id])
  branchId         String?
  branch           Branch?    @relation("BranchMembers", fields: [branchId], references: [id], onDelete: SetNull)
  departmentId     String?
  department       Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position         String?
  status           UserStatus @default(ACTIVE)
  joinDate         DateTime   @default(now())
  lastActivityAt   DateTime?
  lastLoginAt      DateTime?
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  directedBranch      Branch?            @relation("BranchDirector")
  ceoBranches         Branch[]           @relation("BranchCeo")
  tutorGroups         Group[]            @relation("GroupTutor")
  teacherGroups       Group[]            @relation("GroupTeacher")
  createdSurveys      Survey[]           @relation("SurveyCreator")
  assignments         SurveyAssignment[]
  responses           SurveyResponse[]
  reports             Report[]           @relation("ReportAuthor")
  reviewedReports     Report[]           @relation("ReportReviewer")
  notifications       Notification[]
  announcements       Announcement[]     @relation("AnnouncementAuthor")
  announcementReads   AnnouncementRead[]
  assignedTasks       Task[]             @relation("TaskAssignee")
  createdTasks        Task[]             @relation("TaskCreator")
  kpiResults          KpiResult[]
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  telegramSessions    TelegramSession[]
  telegramLinkCodes   TelegramLinkCode[]

  @@index([roleId])
  @@index([branchId])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

/// One-time code shown in the web dashboard so an employee can link Telegram securely.
model TelegramLinkCode {
  id        String    @id @default(cuid())
  code      String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("telegram_link_codes")
}

/// Persisted bot conversation state (so the bot survives restarts and scales horizontally).
model TelegramSession {
  id         String   @id @default(cuid())
  telegramId BigInt   @unique
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  state      Json     @default("{}")
  updatedAt  DateTime @updatedAt

  @@map("telegram_sessions")
}

// ───────────────────────────── Surveys ───────────────────────────────────────

model Survey {
  id            String             @id @default(cuid())
  title         String
  description   String?
  status        SurveyStatus       @default(DRAFT)
  audience      SurveyAudience     @default(ALL)
  branchId      String?
  branch        Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  isAnonymous   Boolean            @default(false)
  allowMultiple Boolean            @default(false)
  scheduledAt   DateTime?
  deadline      DateTime?
  sentAt        DateTime?
  closedAt      DateTime?
  createdById   String
  createdBy     User               @relation("SurveyCreator", fields: [createdById], references: [id])
  questions     SurveyQuestion[]
  assignments   SurveyAssignment[]
  responses     SurveyResponse[]
  notifications Notification[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status])
  @@index([branchId])
  @@map("surveys")
}

model SurveyQuestion {
  id         String         @id @default(cuid())
  surveyId   String
  survey     Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  order      Int
  type       QuestionType
  text       String
  hint       String?
  isRequired Boolean        @default(true)
  minValue   Int?
  maxValue   Int?
  options    SurveyOption[]
  answers    SurveyAnswer[]

  @@index([surveyId, order])
  @@map("survey_questions")
}

model SurveyOption {
  id         String         @id @default(cuid())
  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int
  label      String
  value      String?

  @@map("survey_options")
}

model SurveyAssignment {
  id          String           @id @default(cuid())
  surveyId    String
  survey      Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      AssignmentStatus @default(PENDING)
  notifiedAt  DateTime?
  remindedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())

  @@unique([surveyId, userId])
  @@index([userId, status])
  @@map("survey_assignments")
}

model SurveyResponse {
  id          String         @id @default(cuid())
  surveyId    String
  survey      Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId      String? // null when survey is anonymous
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  branchIdSnap String? // denormalised for analytics even when anonymous
  roleKeySnap RoleKey?
  source      String         @default("telegram") // telegram | web
  startedAt   DateTime       @default(now())
  submittedAt DateTime?
  durationSec Int?
  avgRating   Float? // average of RATING questions in this response
  answers     SurveyAnswer[]

  @@index([surveyId])
  @@index([userId])
  @@index([submittedAt])
  @@map("survey_responses")
}

model SurveyAnswer {
  id          String         @id @default(cuid())
  responseId  String
  response    SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId  String
  question    SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  textValue   String?
  numberValue Float?
  boolValue   Boolean?
  optionIds   String[]       @default([])
  createdAt   DateTime       @default(now())

  @@unique([responseId, questionId])
  @@index([questionId])
  @@map("survey_answers")
}

// ───────────────────────────── Reports ───────────────────────────────────────

model Report {
  id           String       @id @default(cuid())
  type         ReportType
  title        String
  content      String
  status       ReportStatus @default(PENDING)
  authorId     String
  author       User         @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  groupId      String?
  group        Group?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  periodStart  DateTime?
  periodEnd    DateTime?
  reviewerId   String?
  reviewer     User?        @relation("ReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote   String?
  reviewedAt   DateTime?
  attachments  Json         @default("[]")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([authorId])
  @@index([status])
  @@index([type])
  @@map("reports")
}

// ───────────────────────────── Tasks ─────────────────────────────────────────

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(OPEN)
  dueAt       DateTime?
  assigneeId  String
  assignee    User       @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User       @relation("TaskCreator", fields: [createdById], references: [id])
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([assigneeId, status])
  @@map("tasks")
}

// ───────────────────────────── Announcements ─────────────────────────────────

model Announcement {
  id         String               @id @default(cuid())
  title      String
  body       String
  priority   AnnouncementPriority @default(NORMAL)
  audience   SurveyAudience       @default(ALL)
  branchId   String?
  isPinned   Boolean              @default(false)
  publishAt  DateTime             @default(now())
  expiresAt  DateTime?
  authorId   String
  author     User                 @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  reads      AnnouncementRead[]
  sentCount  Int                  @default(0)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@map("announcements")
}

model AnnouncementRead {
  announcementId String
  userId         String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@map("announcement_reads")
}

// ───────────────────────────── Notifications ─────────────────────────────────

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  channel   NotificationChannel @default(BOTH)
  title     String
  body      String
  payload   Json?
  surveyId  String?
  survey    Survey?             @relation(fields: [surveyId], references: [id], onDelete: SetNull)
  status    NotificationStatus  @default(QUEUED)
  sentAt    DateTime?
  readAt    DateTime?
  error     String?
  createdAt DateTime            @default(now())

  @@index([userId, status])
  @@index([createdAt])
  @@map("notifications")
}

// ───────────────────────────── KPI ───────────────────────────────────────────

model KpiMetric {
  id          String       @id @default(cuid())
  key         KpiMetricKey @unique
  name        String
  description String?
  weight      Int          @default(10) // relative weight in total score (sum ≈ 100)
  target      Float        @default(100)
  unit        String       @default("%")
  appliesTo   RoleKey[]    @default([TUTOR, TEACHER])
  isActive    Boolean      @default(true)
  results     KpiResult[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("kpi_metrics")
}

model KpiResult {
  id          String    @id @default(cuid())
  metricId    String
  metric      KpiMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  period      KpiPeriod
  periodStart DateTime
  periodEnd   DateTime
  value       Float // raw value in metric unit
  score       Float // 0-100 normalised
  computedAt  DateTime  @default(now())

  @@unique([metricId, userId, period, periodStart])
  @@index([userId, period, periodStart])
  @@map("kpi_results")
}

// ───────────────────────────── Audit & settings ──────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // e.g. "survey.create"
  entity     String? // e.g. "Survey"
  entityId   String?
  meta       Json?
  ip         String?
  userAgent  String?
  source     String   @default("web") // web | telegram | system
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}
