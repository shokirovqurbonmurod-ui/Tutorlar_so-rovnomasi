# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (web dashboard)
CORS_ORIGINS=http://localhost:3000
# Public URL of the API (used for Telegram webhook + links in messages)
API_PUBLIC_URL=http://localhost:4000
# Public URL of the web dashboard (used in Telegram messages)
WEB_PUBLIC_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tutorsurvey?schema=public

# ── Auth ──────────────────────────────────────────────────────────────────────
# Use long random strings in production:  openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:replace-with-token-from-@BotFather
# polling (dev) | webhook (production)
TELEGRAM_MODE=polling
# Random secret used to validate webhook calls (only for webhook mode)
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret
# Optional: Telegram IDs (comma separated) that are auto-promoted to Super Admin on first /start
TELEGRAM_SUPER_ADMIN_IDS=

# ── Super Admin (created/updated by `npm run db:seed`) ────────────────────────
# Jumayev Baxtbek — Bosh Admin. The password is NEVER stored in code: set it here.
SUPER_ADMIN_NAME=Jumayev Baxtbek
SUPER_ADMIN_EMAIL=admin@target-school.uz
# Quote the value if it contains # or spaces, e.g. "My#Strong Pass"
SUPER_ADMIN_PASSWORD="change-me-strong-password"
SUPER_ADMIN_PHONE=+998900000000
# Demo data (students, groups, grades…) — set false in production
SEED_DEMO=true
SEED_DEMO_PASSWORD=Target2026!

# ── Misc ──────────────────────────────────────────────────────────────────────
# Timezone used for deadlines / cron schedules
TZ=Asia/Tashkent
# Set to "true" to skip starting the bot (e.g. when running API only)
DISABLE_BOT=false
# Set to "true" to skip cron jobs
DISABLE_CRON=false
LOG_LEVEL=info
