{
  "name": "@tutorsurvey/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "npm run db:generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:migrate:local": "tsx scripts/migrate.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx scripts/migrate.ts --reset && tsx prisma/seed.ts",
    "bot:webhook": "tsx scripts/set-webhook.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.0.0",
    "pdfkit": "^0.17.1",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "swagger-ui-express": "^5.0.1",
    "telegraf": "^4.16.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@prisma/driver-adapter-utils": "^7.10.0",
    "@prisma/schema-engine-wasm": "7.10.0-4.0edf323efd1d98336f3f0a68684b56f689b900d3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.0",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.11.14",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^7.10.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
